{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -u -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/push_gate.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -u -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/evidence_capture.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python -u -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_bootstrap.py\""
          }
        ]
      }
    ]
  }
}
